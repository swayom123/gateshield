GATESHIELD_ENVIRONMENT=development
GATESHIELD_DATABASE_URL=sqlite+aiosqlite:///./gateshield.db
GATESHIELD_PROVIDER_BASE_URL=http://127.0.0.1:9001/v1
GATESHIELD_PROVIDER_TYPE=LOCAL
GATESHIELD_PROVIDER_API_KEY=
GATESHIELD_PROVIDER_TIMEOUT_SECONDS=30
GATESHIELD_LOGGING_MODE=REDACTED_CONTENT
GATESHIELD_APPLICATION_ID=local-development
GATESHIELD_APPLICATION_NAME=Local Development
GATESHIELD_MAX_REQUEST_BYTES=1048576
# Set a strong secret to enable agent enrollment. Keep it outside source control.
# GATESHIELD_AGENT_ENROLLMENT_KEY=
GATESHIELD_AGENT_SESSION_TTL_MINUTES=30

